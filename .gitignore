# Roblox Studio Autosaves & Place Files
*.rbxl
*.rbxlx
autosaves/
auto-saves/

# Wally (Luau Package Manager)
Packages/
DevPackages/
ServerPackages/
wally.lock

# Node.js / Tooling (if using Darklua, Rojo plugins, npm tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Secrets & Local Environment
# Open Cloud API keys live here and must never be committed. The example
# file is the template and is deliberately kept tracked.
.env
.env.*
!.env.example

# Logs & Temporary Files
*.log
*.tmp
build/
temp/
